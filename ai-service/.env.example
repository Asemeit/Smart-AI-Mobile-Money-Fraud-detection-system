# OpenRouter LLM Configuration (required for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override default model (default: google/gemma-2-9b-it:free)
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_MODEL=anthropic/claude-3-haiku

# Optional: metadata for OpenRouter dashboard
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=MoMo Fraud Detector

# API Configuration
PORT=8000
# REQUEST_TIMEOUT=30000

# Logging & Debugging
# LOG_LEVEL=info
# ENABLE_RESPONSE_LOGGING=false
